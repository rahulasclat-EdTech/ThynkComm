# ─── WhatsApp Cloud API ───────────────────────────────────────────
# Get these from developers.facebook.com → Your App → WhatsApp → API Setup
WHATSAPP_TOKEN=paste_your_new_token_here
PHONE_NUMBER_ID=paste_your_phone_number_id_here
WABA_ID=paste_your_waba_id_here

# ─── Webhook ──────────────────────────────────────────────────────
# This is a secret string YOU choose — use the same value in Meta dashboard
WEBHOOK_VERIFY_TOKEN=myverifytoken123

# ─── Server ───────────────────────────────────────────────────────
PORT=3001
